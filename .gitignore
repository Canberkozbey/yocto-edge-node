# kas work directory contents, in case kas runs from the repository root.
# The recommended setup keeps them outside (see README).
/build/
/bitbake/
/openembedded-core/
/meta-yocto/
/meta-openembedded/
/meta-raspberrypi/
/meta-rauc/
/.kas_shell_history

# Keys and CI runner credentials never belong here: keys live on the build
# host and in GitHub's secrets (docs/updates.md, docs/releases.md), the
# runner in its own directory (docs/lab.md). A guard against mistakes.
*.key
*.key.pem
*-key.pem
/actions-runner/
.credentials
.credentials_rsaparams
.runner

# Python
.venv/
__pycache__/
.pytest_cache/

# Test logs written by CI and local runs
/test-logs/

# Standalone builds of edgenoded (its Makefile)
/meta-edgenode/recipes-edgenode/edgenoded/files/edgenoded/*.o
/meta-edgenode/recipes-edgenode/edgenoded/files/edgenoded/fonts.c
/meta-edgenode/recipes-edgenode/edgenoded/files/edgenoded/edgenoded

# Standalone build of edgenode-boot (its Makefile)
/meta-edgenode/dynamic-layers/rauc/recipes-bsp/edgenode-boot/files/edgenode-boot/edgenode-boot
