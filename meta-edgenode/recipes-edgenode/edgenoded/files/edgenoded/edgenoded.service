[Unit]
Description=Edge node daemon
After=network.target
# The site's configuration and the node's identity, on the data partition
# where there is one (docs/adr/0011).
Wants=edgenoded-site.service
After=edgenoded-site.service

[Service]
Type=notify
ExecStart=/usr/bin/edgenoded
Restart=on-failure
RestartSec=2s

# Liveness: systemd restarts the daemon if it stops sending keep-alives.
WatchdogSec=30s

# Runs as a transient, unprivileged user that owns nothing on disk. Its
# group edgenode-identity reads the site's configuration and the node's
# MQTT key and certificates on /data, which no other account can.
DynamicUser=yes
SupplementaryGroups=edgenode-identity

# Sandboxing. `systemd-analyze security edgenoded` scores the result.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# A machine with a display opens DRM devices instead, through a drop-in
# from its edgenode-config (docs/adr/0006).
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
