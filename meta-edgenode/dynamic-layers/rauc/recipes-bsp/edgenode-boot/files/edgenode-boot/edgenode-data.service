# Creates the directories on the data partition, right after it is mounted
# and before any ordinary service starts: RAUC's status (system.conf) and
# SSH's, with the host keys (run-ssh.mount) and root's keys
# (data-keys.conf), each for root only. A tmpfiles.d entry would run on
# every boot, and fail on a read-only root filesystem when the partition is
# not mounted. Added to boots from an A/B slot only, by
# edgenode-boot-generator. (edgenoded makes its own site directory,
# edgenoded-site.service.)
[Unit]
Description=Directories on the persistent data partition
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=local-fs.target
ConditionKernelCommandLine=rauc.slot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p -m 0700 /data/rauc /data/ssh
